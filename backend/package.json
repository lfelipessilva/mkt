{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/shared/db/migrate.ts",
    "media:scan": "tsx scripts/scan-media.ts",
    "test": "NODE_ENV=test tsx --test --test-concurrency=1 \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.8",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
